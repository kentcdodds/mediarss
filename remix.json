{
	"$schema": "./node_modules/remix/schema/remix.json",
	"assets": {
		"rootDir": ".",
		"basePath": "/assets",
		"allowFiles": [
			"app/assets/styles.css",
			"app/client/**",
			"app/components/modal.tsx",
			"app/components/props-component.ts",
			"app/components/search-input.tsx",
			"app/config/routes.ts",
			"app/helpers/feed-list-sort.ts",
			"app/helpers/format.ts",
			"app/helpers/media-list-sort.ts",
			"app/styles/**"
		],
		"allowPackages": ["match-sorter", "remix"],
		"denyFiles": ["app/**/*.test.*"]
	},
	"db": {
		"adapter": {
			"type": "sqlite",
			"filename": {
				"env": "DATABASE_PATH",
				"default": "./data/sqlite.db"
			},
			"foreignKeys": true
		},
		"migrations": {
			"directory": "./app/db/migrations"
		}
	}
}
